let currentProduct = "";
let currentPrice = "";
let cartCount = 0;

// 1. Add to Cart Function
function addToCart() {
    cartCount++;
    document.getElementById('cart-count').innerText = cartCount;
    alert("Saman cart mein jud gaya hai! Kul saman: " + cartCount);
}

// 2. Buy Now Function
function buyNow(name, price) {
    currentProduct = name;
    currentPrice = price;
    
    // Popup dikhayein
    const modal = document.getElementById('orderModal');
    const summary = document.getElementById('orderSummary');
    
    if(modal) {
        summary.innerHTML = "Product: " + name + " | Price: ₹" + price;
        modal.style.display = "block";
    } else {
        alert("Error: Modal nahi mila!");
    }
}

function closeModal() {
    document.getElementById('orderModal').style.display = "none";
}

// 3. WhatsApp Message Sending
function sendToWhatsApp() {
    let name = document.getElementById('custName').value;
    let phone = document.getElementById('custPhone').value;
    let address = document.getElementById('custAddress').value;

    if(name == "" || phone == "" || address == "") {
        alert("Kripya saari details bhariye!");
        return;
    }

    let myNumber = "918521684137";
    let message = `*Dkart Order*%0A*Product:* ${currentProduct}%0A*Price:* ₹${currentPrice}%0A*Customer:* ${name}%0A*Address:* ${address}`;

    let url = "https://api.whatsapp.com/send?phone=" + myNumber + "&text=" + message;
    window.open(url, '_blank');
    
    closeModal();
}
