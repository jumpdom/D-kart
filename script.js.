let currentProduct = "";
let currentPrice = "";

function filterProduct(category) {
    let products = document.querySelectorAll('.product-card');
    document.getElementById('section-title').innerText = category.toUpperCase() + " Products";
    products.forEach(p => {
        if (category === 'all' || p.getAttribute('data-category') === category) {
            p.style.display = 'block';
        } else {
            p.style.display = 'none';
        }
    });
}

function addToCart() {
    let count = document.getElementById('cart-count');
    count.innerText = parseInt(count.innerText) + 1;
    alert("Added to cart!");
}

function buyNow(name, price) {
    currentProduct = name;
    currentPrice = price;
    document.getElementById('orderSummary').innerHTML = `<p>Order: ${name} (₹${price})</p>`;
    document.getElementById('orderModal').style.display = "block";
}

function closeModal() {
    document.getElementById('orderModal').style.display = "none";
}

function sendToWhatsApp() {
    let name = document.getElementById('custName').value;
    let phone = document.getElementById('custPhone').value;
    let address = document.getElementById('custAddress').value;

    if(name == "" || phone == "" || address == "") {
        alert("Saari jankari bhariye!");
        return;
    }

    let myNumber = "918521684137"; 
    let message = `*Dkart Naya Order*%0A------------------%0A*Product:* ${currentProduct}%0A*Price:* ₹${currentPrice}%0A%0A*Customer:* ${name}%0A*Mob:* ${phone}%0A*Address:* ${address}`;

    let url = `https://api.whatsapp.com/send?phone=${myNumber}&text=${message}`;
    
    window.open(url, '_blank');
    alert("Order Confirmed!");
    closeModal();
}

function searchFunction() {
    let input = document.getElementById('searchInput').value.toLowerCase();
    let cards = document.querySelectorAll('.product-card');
    cards.forEach(card => {
        let title = card.querySelector('h4').innerText.toLowerCase();
        card.style.display = title.includes(input) ? "block" : "none";
    });
}
